<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EasytierGame.Desktop.Views.CoreManagerWindow"
        Title="内核管理"
        Width="500"
        Height="380"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="14" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

    <TextBlock Grid.Row="0" Margin="0,0,0,6">
      <Run Text="当前版本: " />
      <Run Text="{Binding CurrentVersion, Mode=OneWay}" FontWeight="SemiBold" />
    </TextBlock>

    <ProgressBar Grid.Row="1" Height="8" Margin="0,0,0,8"
                 Minimum="0" Maximum="100"
                 Value="{Binding Progress, Mode=OneWay}"
                 IsVisible="{Binding IsInstalling}" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
      <TextBlock Text="选择一个内核版本安装" Classes="fieldLabel" />
      <Button Content="刷新列表" Classes="text" Command="{Binding LoadReleasesCommand}" />
      <Button Content="打开缓存目录" Classes="text" Command="{Binding OpenCacheCommand}" />
    </StackPanel>

    <ComboBox Grid.Row="3"
              HorizontalAlignment="Stretch"
              ItemsSource="{Binding Releases}"
              SelectedItem="{Binding SelectedRelease, Mode=TwoWay}"
              PlaceholderText="请选择内核版本">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding TagName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding AssetName}" Classes="fieldLabel" />
          </StackPanel>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <StackPanel Grid.Row="4" Margin="0,10,0,0" Spacing="6">
      <TextBlock Text="github下载加速地址" Classes="fieldLabel" />
      <TextBox Text="{Binding GithubFastUrl, Mode=TwoWay}"
               Watermark="不使用出国软件也能下载 github Release 包的地址" />
      <Button Content="获取最新加速地址" Classes="text" HorizontalAlignment="Left" Click="OnOpenGhProxy" />
    </StackPanel>

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="安装" Classes="primary" MinWidth="80" Command="{Binding InstallCommand}" />
      <Button Content="关闭" MinWidth="80" Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
