<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EasytierGame.Desktop.Views.ImportShareDialog"
        Title="导入分享"
        Width="480"
        Height="280"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="14" RowDefinitions="Auto,*,Auto">

    <TextBlock Grid.Row="0" Text="请粘贴分享的配置" Classes="fieldLabel" Margin="0,0,0,6" />

    <TextBox Grid.Row="1"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalContentAlignment="Top"
             Text="{Binding Input, Mode=TwoWay}" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="导入" Classes="primary" MinWidth="80" Click="OnImport" />
      <Button Content="取消" MinWidth="80" Click="OnCancel" />
    </StackPanel>
  </Grid>
</Window>
