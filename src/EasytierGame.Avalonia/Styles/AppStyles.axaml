<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 全局字体与字号：与 WPF 版一致（正文 15、标签 13） -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 表单标签 -->
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 输入控件统一高度 -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MaxDropDownHeight" Value="280" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- 主按钮（联机中变红：由 Classes.danger 覆盖，依靠顺序后者优先） -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#409EFF" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="#F56C6C" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!--
    Fluent 主题会在悬停/按下时改写模板里 ContentPresenter 的 Background，
    只设 Button.Background 会被盖掉，看起来像灰色。
    因此必须针对模板子元素覆盖各状态。
  -->
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#66B1FF" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3A8EE6" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#A0CFFF" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F78989" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#DD6161" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FAB6B6" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.plainPrimary">
    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <Style Selector="Button.plainSuccess">
    <Setter Property="Background" Value="{DynamicResource SuccessLightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <Style Selector="Button.plainInfo">
    <Setter Property="Background" Value="{DynamicResource InfoLightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <Style Selector="Button.text">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Padding" Value="6,2" />
  </Style>

  <!-- 状态标签 -->
  <Style Selector="Border.tag">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="{DynamicResource InfoLightBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.tag > TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</Styles>
